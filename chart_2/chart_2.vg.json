{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title" : "Renewable Energy Consumption",
  "width" : 800,
  "height" : 600,
  "data" : {
    "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_2/data/renewable_energy.csv",
    "format" : {"type": "csv"}
  },
  "transform" : [
    {
      "filter": {"field": "Country Code", "oneOf": ["AUS", "USA", "CHN", "MYS", "JPN"]} 
    },
    {
      "lookup": "Country Code",
      "from": {
        "data" : {
          "values" : [
            {"code" : "AUS", "name":"Australia"},
            {"code" : "USA", "name":"United States"},
            {"code" : "CHN", "name":"China"},
            {"code" : "MYS", "name":"Malaysia"},
            {"code" : "JPN", "name":"Japan"}
          ]
        },
        "key" : "code",
        "fields": ["name"]
      },
      "as" : "Country"
    },
    {
      "fold" : [
        "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017",
        "2018", "2019", "2020"
      ],
      "as" : ["Year", "Renewable Energy Use"]
    },
    {
      "calculate": "toNumber(datum['Renewable Energy Use'])",
      "as" : "Renewable Energy Use"
    }
  ],
  
  "mark": {"type": "line"},
  "encoding": {
    "x" : {
      "field" : "Year",
      "type" : "nominal",
      "title": "Year"
    },
    "y": {
      "field": "Renewable Energy Use",
      "type": "quantitative",
      "title" : "Renewable energy consumption (%)"
    },
    "color" : {
      "field": "Country",
      "type" : "nominal", 
      "title" : "Country",
      "scale" : {
        "domain": ["Australia", "United States", "China", "Malaysia", "Japan"],
        "range": ["#d62728", "#ff7f0e", "#17BECF", "#9467bd", "#e377c2", "#3c20a3", "#8c564b"]
      }
    } 
  }
}