{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title" : "Energy Consumption Rate",
  "data" : {
    "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_1/data/energy_use.csv",
    "format" : {"type": "csv"}
  },
  "transform" : [
    {
      "filter": {"field": "Country Code", "oneOf": ["AUS", "USA", "GBR", "CHN", "MYS", "JPN"]} 
    },
    {
      "lookup": "Country Code",
      "from": {
        "data" : {
          "values" : [
            {"code" : "AUS", "name":"Australia"},
            {"code" : "USA", "name":"United States"},
            {"code" : "GBR", "name":"United Kingdom"},
            {"code" : "CHN", "name":"China"},
            {"code" : "MYS", "name":"Malaysia"},
            {"code" : "JPN", "name":"Japan"}
          ]
        },
        "key" : "code",
        "fields": ["name"]
      },
      "as" : "Country"
    },
    {
      "fold" : [
        "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017",
        "2018", "2019", "2020", "2020"
      ],
      "as" : ["Year", "Energy Use"]
    },
    {
      "calculate": "toNumber(datum['Energy Use'])",
      "as" : "Energy Use"
    }
  ],
  
  "mark": {"type": "line"},
  "encoding": {
    "x" : {
      "field" : "Year",
      "type" : "nominal",
      "title": "Year"
    },
    "y": {
      "field": "Energy Use",
      "type": "quantitative",
      "title" : "Energy use (kg of oil equivalent per capita)"
    },
    "color" : {
      "field": "Country",
      "type" : "nominal", 
      "title" : "Country"
    } 
  }
}