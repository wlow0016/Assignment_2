{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title" : "Energy Consumption Rate",
  "data" : {
    "url": "./data/energy_use.csv",
    "format" : {"type": "csv"}
  },
  "transform" : [
    {
      "filter": "datum['\uFEFFCountry Name'] == 'Australia'"    
    },
    {
      "fold" : [
        "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017",
        "2018", "2019", "2020", "2021", "2022", "2023"
      ],
      "as" : ["Year", "Energy Use"]
    },
    {
      "calculate": "toNumber(datum['Energy Use'])",
      "as" : "Energy Use"
    }
  ],
  "mark": {"type": "line", "point" : true},
  "encoding": {
    "x" : {
      "field" : "Year",
      "type" : "nominal",
      "title": "Year"
    },
    "y": {
      "field": "Energy Use",
      "type": "quantitative",
      "title" : "Energy use (kg of oil equivalent per capita)"
    },
    "color" : {
      "field": "\uFEFFCountry Name",
      "type" : "nominal", 
      "title" : "Country"
    } 
  }
}