{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title" : "Fossil Fuel VS Renewable",
  "layer" : [
    {
    "data" : {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_3/data/global-fossil-fuel-consumption.csv",
        "format" : {"type": "csv"}
    },
    "transform" : [
        {"filter" : "datum.Year >= 2010 && datum.Year <= 2020"},
        {
            "calculate": "toNumber(datum.Gas) + toNumber(datum.Oil) + toNumber(datum.Coal)",
            "as": "Value"
        },
        {"calculate":"'Fossil Fuel'", "as": "Energy Type"}
    ],
    "mark": {"type":"area", "opacity":0.7},
    "encoding": {
        "x" : {
        "field" : "Year",
        "type" : "nominal"
        },
        "y": {
        "field": "Value",
        "type": "quantitative",
        "title" : "Energy (TwH)"
        },
        "color" : {
        "field": "Energy Type",
        "type" : "nominal"
        }
    }
    },
    {
    "data":{
        "url" : "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_3/data/renewable-energy-consumption.csv",
        "format" : {"type": "csv"}
    },

    "transform" : 
    [
        {"filter" : "datum.Year >= 2010 && datum.Year <= 2020"},
        {
            "calculate": "toNumber(datum['Other renewables']) + toNumber(datum.Solar) + toNumber(datum['Modern biofuels']) + toNumber(datum.Wind) + toNumber(datum.Hydropower) + toNumber(datum['Traditional biomass'])",
            "as": "Value"
        },
        {"calculate":"'Renewable'", "as": "Energy Type"}
        ],
        "mark": {"type": "area", "opacity":0.7},
        "encoding": {
            "x" : {
            "field" : "Year",
            "type" : "nominal"
            },
            "y": {
            "field": "Value",
            "type": "quantitative",
            "title" : "Energy (Twh)"
            },
            "color" : {
            "field": "Energy Type",
            "type" : "nominal"
            } 
            }
        }    
    ]
}