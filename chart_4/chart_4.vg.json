{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Global Map Renewable Energy Consumption",
  "width": 800,
  "height": 400,
  "projection": {"type": "equalEarth"},
  "layer" : [
        {
    "data": {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_4/ne_110m.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    "mark" : {"type":"geoshape", "fill":"#d3d3d3", "stroke": "white"}
        },
        {
        "data": {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_4/ne_110m.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}  
        },
        "transform": [
        {
            "calculate": "datum.properties.ISO_A3 === '-99' ? datum.properties.NAME : datum.properties.ISO_A3",
            "as": "lookup_key"
        },
        {
            "calculate": "datum.lookup_key === 'France' ? 'FRA' : datum.lookup_key === 'Norway' ? 'NOR' : datum.lookup_key",
            "as" : "lookup_key"
        },
        {
        "lookup": "lookup_key",
        "from": {
            "data": {
            "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_4/data/renewable_energy.csv"
            },
            "key": "Country Code",
            "fields": ["2020"]
        }
        },
        {"filter" : "datum['2020'] !== null"}
    ],
    "mark": {"type": "geoshape", "stroke" : "white"},
    "encoding": {
        "color": {
            "field": "2020",
            "type": "quantitative",
            "title": "Renewable Energy",
            "scale": {"type": "linear", "domain" : [0,100], "scheme" : "pinkyellowgreen"},
            "legend" : {"title": "Renewable Energy (%)", "type": "gradient", "orient": "bottom-left", "gradientLength": 200}
        },
        "tooltip": [
        {"field": "properties.NAME", "type": "nominal", "title": "Country"},
        {"field": "2020", "type": "quantitative", "title" : "Renewable Energy (%) 2020", "format": ".1f"}
        ]
    }
    }
    ]
}
