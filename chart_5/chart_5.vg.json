    {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 800,
    "height": 600,
    "title": "Energy Use vs CO₂ Emissions by Country",
    "data": {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_5/data/energy_use.csv"
    },
    "params": [
        {
        "name": "Energy_Use",
        "value": 0,
        "bind": {
            "input": "range",
            "min": 0,
            "max": 20000,
            "step": 500,
            "name": "Mininum Energy Use: "
        }
        },
        {
        "name": "Region_selection",
        "bind": {
            "input": "select",
            "options": [
            null,  
            "North America",
            "Latin America & Caribbean",
            "Europe & Central Asia",
            "Middle East & North Africa",
            "Sub-Saharan Africa",
            "South Asia",
            "East Asia & Pacific"
            ],
            "labels": [
            "Show All",
            "North America",
            "Latin America & Caribbean",
            "Europe & Central Asia",
            "Middle East & North Africa",
            "Sub-Saharan Africa",
            "South Asia",
            "East Asia & Pacific"
            ],
            "name": "Region Selection: "
        }
        }
    ],
    "transform": [
        {
            "lookup": "Country Code",
            "from" : {
                "data": {
                    "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_5/data/CO2.csv"
                },
                "key": "Country Code",
                "fields": ["2020"]
            },
            "as" : "co2"
        },
        {"calculate": "toNumber(datum['2020'])", "as": "energy"},
        {"calculate": "toNumber(datum.co2)", "as" : "co2_val"},
        {"filter" : "datum.energy > 0 && datum.co2_val > 0"},
        {"filter" : "datum.energy > Energy_Use"},
        {"filter" : "Region_selection == null || datum.region == Region_selection"}
    ],
    "layer": [
        {
            "mark":{"type" : "circle","opacity":1, "size":60},
            "encoding": {
                "x" : {
                    "field":"energy",
                    "type": "quantitative",
                    "title":"Energy Use (kg of oil equivalent per capita)",
                    "scale":{"type": "log", "domain":[1,50000], "clamp":true},
                    "axis" : {
                        "values":[0,100,1000,10000,50000],
                        "grid": true
                }
                },
                "y":{
                    "field":"co2_val",
                    "type": "quantitative",
                    "title":"CO₂ Emissions (Mt)",
                    "scale":{"type": "log", "domain":[1,50000], "clamp":true},
                    "axis" : {
                        "values":[0,100,1000, 10000, 50000 ],
                        "grid": true
                    }
                },
                "color":{
                    "field":"region",
                    "type": "nominal",
                    "title":"Region",
                    "scale":{
                        "domain": [
                            "North America",
                            "Latin America & Caribbean",
                            "Europe & Central Asia",
                            "Middle East & North Africa",
                            "Sub-Saharan Africa",
                            "South Asia",
                            "East Asia & Pacific"
                        ],
                        "range": [
                            "#d62728", "#ff7f0e", "#17BECF", "#9467bd", "#e377c2", "#3c20a3", "#8c564b"
                        ]
                    }
                
                },
                "tooltip":[
                    {"field":"Country Name", "type":"nominal","title":"Country"},
                    {"field":"energy", "type": "quantitative","title":"Energy Use", "format":",.0f"},
                    {"field":"co2_val", "type": "quantitative","title":"CO₂ Emissions (Mt)","format":",.1f"},
                    {"field":"region", "type": "nominal","title":"Region"}
                ]
            }
        },
        {
            "mark": {
                "type":"text",
                "align":"right",
                "baseline" : "middle",
                "dx":-10,
                "fontSize":11,
                "fontStyle":"italic"
            },
            "encoding": {
                "x":{"field":"energy","type": "quantitative","scale":{"type": "log", "domain":[100,50000]}},
                "y":{"field":"co2_val", "type": "quantitative","scale" : {"type": "log", "domain":[1,50000]}},
                "text":{"field":"Country Name", "type": "nominal"},
                "color":{"value":"black"},
                "opacity":{
                    "condition":{
                        "test":"datum['Country Name'] == 'Australia' || datum['Country Name'] == 'China' || datum['Country Name'] == 'Japan' || datum['Country Name'] == 'Malaysia' || datum['Country Name'] == 'United States'",
                        "value" : 1
                    },
                    "value":0
                },
                "tooltip":[
                    {"field":"Country Name", "type":"nominal","title":"Country"},
                    {"field":"energy", "type": "quantitative","title":"Energy Use", "format":",.0f"},
                    {"field":"co2_val", "type": "quantitative","title":"CO₂ Emissions (Mt)","format":",.1f"},
                    {"field":"region", "type": "nominal","title":"Region"}
                ]
            }
        }
    ]
    }