{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Global Map Renewable Energy Consumption",
  "width": 800,
  "height": 400,
  "projection": {"type": "mercator"},
  "layer" : [
        {
    "data": {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/ne_110m._asean_countriesjson.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    "mark" : {"type":"geoshape", "fill":"#d3d3d3", "stroke": "white"}
        },
        {
        "data": {
        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/ne_110m._asean_countriesjson.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}  
        },
        "transform": [
        {
            "calculate": "datum.properties.ISO_A3 === '-99' ? datum.properties.NAME : datum.properties.ISO_A3",
            "as": "lookup_key"
        },
        {
        "lookup": "lookup_key",
        "from": {
            "data": {
            "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/data/renewabe_energy.csv"
            },
            "key": "Country Code",
            "fields": ["2020"]
        }
        }
    ],
    "mark": {"type": "geoshape", "stroke" : "white"},
    "encoding": {
        "color": {
            "field": "2020",
            "type": "quantitative",
            "title": "Renewable Energy Use (%)",
            "scale": {"type": "linear", "domain" : [0,100], "scheme" : "pinkyellowgreen"},
            "legend" : {"title": "Renewable Energy (%)", "type": "gradient", "orient": "bottom-left", "gradientLength": 200}
        },
        "tooltip": [
        {"field": "properties.NAME", "type": "nominal", "title": "Country"},
        {"field": "2020", "type": "quantitative", "title" : "Renewable Energy (%) 2020", "format": ".1f"}
        ]
    }
    },
    {
        "data": {
                "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/ne_110m._asean_countriesjson.json",
                "format":{"type": "topojson", "feature": "ne_110m_admin_0_countries"}
        },
        "transform": [
            {"filter":"datum.properties.ISO_A3 == 'MYS'"}
        ],
        "mark":{
            "type": "geoshape",
            "fill": null,
            "stroke":"#2b2b2b",
            "strokeWidth": 2.5
        }
    },
    {
        "data": {
                "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/ne_110m._asean_countriesjson.json",
                "format":{"type": "topojson", "feature": "ne_110m_admin_0_countries"}
        },
        "transform": [
            {"filter":"datum.properties.ISO_A3 == 'MYS'"},
            {
                "lookup": "properties.ISO_A3",
                "from":{
                    "data":{
                        "url": "https://raw.githubusercontent.com/wlow0016/Assignment_2/refs/heads/main/chart_7/data/renewabe_energy.csv"
                        },
                        "key": "Country Code",
                        "fields": ["2020"]
                }
            },
            {
                "calculate": "'Malaysia\\n' + format(datum['2020'], '.1f') + '%'",
                "as": "label_text"
            }
        ],
        "mark":{
            "type": "text",
            "fontWeight":"bold",
            "lineBreak":"\n",
            "fontSize":12,
            "color": "#111111",
            "dy":-35,
            "dx":-55
        },
        "encoding": {
            "longitude":{"field": "properties.LABEL_X", "type": "quantitative"},
            "latitude":{"field":"properties.LABEL_Y", "type": "quantitative"},
            "text":{"field":"label_text", "type": "nominal"}
        }
    }
    ]
}
